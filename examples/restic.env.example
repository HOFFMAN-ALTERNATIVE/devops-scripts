RESTIC_REPOSITORY=s3:https://s3.example.com/YOUR_BUCKET/YOUR_HOST
RESTIC_PASSWORD=CHANGE_ME_LONG_RANDOM
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
BACKUP_PATHS="/etc /srv /var/lib/docker/volumes"
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
# Optional alerts
TG_TOKEN=
TG_CHAT=
